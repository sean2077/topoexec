{
  "schema_version": 1,
  "id": "trigger-semantics",
  "title": "Trigger semantics showcase",
  "category": "Execution Semantics",
  "summary": "One graph showing any_input, all_inputs, time_sync, batch, rate_limit, debounce, and condition trigger policies.",
  "difficulty": "intermediate",
  "graph": "trigger_semantics.yaml",
  "show_in_readme": true,
  "readme_priority": 30,
  "expected_exit": 0,
  "commands": [
    {
      "label": "Validate",
      "argv": [
        "graph",
        "validate",
        "examples/20-triggers/trigger_semantics.yaml"
      ],
      "expect_success": true
    },
    {
      "label": "Render",
      "argv": [
        "graph",
        "render",
        "examples/20-triggers/trigger_semantics.yaml",
        "--format",
        "mermaid"
      ],
      "expect_success": true
    },
    {
      "label": "Run",
      "argv": [
        "graph",
        "run",
        "examples/20-triggers/trigger_semantics.yaml",
        "--steps",
        "3"
      ],
      "expect_success": true
    },
    {
      "label": "Explain",
      "argv": [
        "graph",
        "explain",
        "examples/20-triggers/trigger_semantics.yaml"
      ],
      "expect_success": true
    }
  ],
  "assets": {
    "generate_graph": true,
    "generate_metrics_summary": false,
    "generate_trace_summary": false
  },
  "ci": {
    "validate": true,
    "run": true,
    "render": true,
    "smoke": true
  },
  "related_docs": [
    "docs/21-architecture/runtime-semantics.md",
    "docs/62-schemas-protocols/diagnostics.md"
  ],
  "tags": [
    "trigger",
    "readiness",
    "suppression"
  ]
}
