{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topoexec.dev/schemas/example-metadata.v1.json",
  "title": "TopoExec example metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "category",
    "summary",
    "difficulty",
    "graph",
    "commands",
    "assets",
    "ci",
    "related_docs",
    "tags"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "graph": {
      "type": "string",
      "minLength": 1
    },
    "show_in_readme": {
      "type": "boolean"
    },
    "readme_priority": {
      "type": "integer"
    },
    "expected_exit": {
      "type": "integer"
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "argv"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "argv": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string"
            }
          },
          "expect_success": {
            "type": "boolean"
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generate_graph",
        "generate_metrics_summary",
        "generate_trace_summary"
      ],
      "properties": {
        "generate_graph": {
          "type": "boolean"
        },
        "generate_metrics_summary": {
          "type": "boolean"
        },
        "generate_trace_summary": {
          "type": "boolean"
        }
      }
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validate",
        "run",
        "render",
        "smoke"
      ],
      "properties": {
        "validate": {
          "type": "boolean"
        },
        "run": {
          "type": "boolean"
        },
        "render": {
          "type": "boolean"
        },
        "smoke": {
          "type": "boolean"
        }
      }
    },
    "related_docs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
