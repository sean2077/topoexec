@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(TOPOEXEC_VERSION "@PROJECT_VERSION@")
set(TOPOEXEC_SCHEMA_VERSION @TOPOEXEC_SCHEMA_VERSION@)
set(TOPOEXEC_SEMANTIC_CONTRACT_VERSION "@TOPOEXEC_SEMANTIC_CONTRACT_VERSION@")
set(TOPOEXEC_HAS_RUNTIME TRUE)
set(TOPOEXEC_HAS_ADAPTER_SDK TRUE)
set(TOPOEXEC_HAS_C_API @TOPOEXEC_BUILD_C_API@)
set(TOPOEXEC_HAS_PYTHON_PREVIEW @TOPOEXEC_BUILD_PYTHON_PREVIEW@)
set(TOPOEXEC_HAS_PLUGIN_LOADER @TOPOEXEC_BUILD_PLUGIN_LOADER@)
set(TOPOEXEC_HAS_OTEL_ADAPTER @TOPOEXEC_BUILD_OTEL_ADAPTER@)
set(TOPOEXEC_HAS_PROMETHEUS_ADAPTER @TOPOEXEC_BUILD_PROMETHEUS_ADAPTER@)
set(TOPOEXEC_HAS_ROS2_ADAPTER @TOPOEXEC_BUILD_ROS2_ADAPTER@)
set(TOPOEXEC_HAS_YAML @TOPOEXEC_BUILD_YAML@)
set(TOPOEXEC_HAS_CLI @TOPOEXEC_BUILD_CLI@)
set(TOPOEXEC_HAS_EXAMPLES @TOPOEXEC_BUILD_EXAMPLES@)

set(_topoexec_yaml_requested FALSE)
foreach(_topoexec_component IN LISTS topoexec_FIND_COMPONENTS)
  if(_topoexec_component STREQUAL "yaml")
    set(_topoexec_yaml_requested TRUE)
  endif()
endforeach()

if(TOPOEXEC_HAS_YAML AND _topoexec_yaml_requested)
  find_dependency(nlohmann_json)
  find_dependency(PkgConfig)
  pkg_check_modules(YAML_CPP REQUIRED IMPORTED_TARGET yaml-cpp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/topoexecTargets.cmake")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/topoexecAdapterTargets.cmake")
  include("${CMAKE_CURRENT_LIST_DIR}/topoexecAdapterTargets.cmake")
endif()

set(topoexec_core_FOUND TRUE)
set(topoexec_runtime_FOUND TRUE)
set(topoexec_adapter_sdk_FOUND TRUE)
set(topoexec_c_api_FOUND FALSE)
if(TARGET topoexec::c_api)
  set(topoexec_c_api_FOUND TRUE)
endif()
set(topoexec_python_preview_FOUND ${TOPOEXEC_HAS_PYTHON_PREVIEW})
set(topoexec_plugin_loader_FOUND FALSE)
if(TARGET topoexec::plugin_loader)
  set(topoexec_plugin_loader_FOUND TRUE)
endif()
set(topoexec_otel_FOUND FALSE)
if(TARGET topoexec_adapters::otel)
  set(topoexec_otel_FOUND TRUE)
endif()
set(topoexec_prometheus_FOUND FALSE)
if(TARGET topoexec_adapters::prometheus)
  set(topoexec_prometheus_FOUND TRUE)
endif()
set(topoexec_ros2_FOUND FALSE)
if(TARGET topoexec_adapters::ros2)
  set(topoexec_ros2_FOUND TRUE)
endif()
set(topoexec_yaml_FOUND FALSE)
if(TARGET topoexec::yaml)
  set(topoexec_yaml_FOUND TRUE)
endif()
set(topoexec_cli_FOUND FALSE)
if(TARGET topoexec::topoexec_cli)
  set(topoexec_cli_FOUND TRUE)
endif()

check_required_components(topoexec)

unset(_topoexec_yaml_requested)
unset(_topoexec_component)
