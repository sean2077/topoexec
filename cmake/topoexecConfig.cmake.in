@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(TOPOEXEC_VERSION "@PROJECT_VERSION@")
set(TOPOEXEC_SCHEMA_VERSION @TOPOEXEC_SCHEMA_VERSION@)
set(TOPOEXEC_SEMANTIC_CONTRACT_VERSION "@TOPOEXEC_SEMANTIC_CONTRACT_VERSION@")
set(TOPOEXEC_HAS_RUNTIME TRUE)
set(TOPOEXEC_HAS_YAML @TOPOEXEC_BUILD_YAML@)
set(TOPOEXEC_HAS_CLI @TOPOEXEC_BUILD_CLI@)
set(TOPOEXEC_HAS_EXAMPLES @TOPOEXEC_BUILD_EXAMPLES@)

set(_topoexec_yaml_requested FALSE)
foreach(_topoexec_component IN LISTS topoexec_FIND_COMPONENTS)
  if(_topoexec_component STREQUAL "yaml")
    set(_topoexec_yaml_requested TRUE)
  endif()
endforeach()

if(TOPOEXEC_HAS_YAML AND _topoexec_yaml_requested)
  find_dependency(nlohmann_json)
  find_dependency(PkgConfig)
  pkg_check_modules(YAML_CPP REQUIRED IMPORTED_TARGET yaml-cpp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/topoexecTargets.cmake")

set(topoexec_core_FOUND TRUE)
set(topoexec_runtime_FOUND TRUE)
set(topoexec_yaml_FOUND FALSE)
if(TARGET topoexec::yaml)
  set(topoexec_yaml_FOUND TRUE)
endif()
set(topoexec_cli_FOUND FALSE)
if(TARGET topoexec::topoexec_cli)
  set(topoexec_cli_FOUND TRUE)
endif()

check_required_components(topoexec)

unset(_topoexec_yaml_requested)
unset(_topoexec_component)
